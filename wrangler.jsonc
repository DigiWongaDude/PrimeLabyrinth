{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "between-g5-api",
  "main": "backend/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4175,http://127.0.0.1:4175",
    "REGISTRATION_ENABLED": "false",
    "MAX_TRAVELLERS": "100"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "between-g5",
    // Local placeholder. No resource is provisioned by this project.
    "database_id": "00000000-0000-0000-0000-000000000005",
    "migrations_dir": "backend/migrations"
  }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "5001", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "5002", "simple": { "limit": 5, "period": 60 } }
  ]
}
